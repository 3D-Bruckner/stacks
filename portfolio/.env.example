# portfolio's settings on the server, written by the deployment from its vault. Every name is explained in portfolio's
# docs/configuration.md (https://github.com/3D-Bruckner/portfolio/blob/main/docs/configuration.md).

# This server's address on the private network; compose.yaml publishes the port there only.
PRIVATE_IP=

PUBLIC_URL=https://portfolio.3dbruckner.de
PORTFOLIO_SECRET=
PORTFOLIO_ALLOWED_EMAILS=
PORTFOLIO_SMTP_URL=
PORTFOLIO_SMTP_FROM=3D Bruckner <noreply@3dbruckner.de>
# Empty: nothing starts the site's build yet.
PORTFOLIO_GITHUB_TOKEN=
TZ=Europe/Berlin
