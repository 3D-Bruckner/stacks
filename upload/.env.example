# upload's settings on the server, written by the deployment from its vault. Every name is explained in upload's
# docs/configuration.md (https://github.com/3D-Bruckner/upload/blob/main/docs/configuration.md).

# This server's address on the private network; compose.yaml publishes the port there only.
PRIVATE_IP=

PUBLIC_URL=https://upload.3dbruckner.de
UPLOAD_SECRET=
UPLOAD_ALLOWED_EMAILS=
UPLOAD_SMTP_URL=
UPLOAD_SMTP_FROM=3D Bruckner <noreply@3dbruckner.de>
# Empty: nothing starts the site's build yet.
UPLOAD_GITHUB_TOKEN=
TZ=Europe/Berlin
