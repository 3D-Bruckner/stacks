# preview's settings on the server, written by the deployment from its vault. Every name is explained in preview's
# docs/configuration.md (https://github.com/3D-Bruckner/preview/blob/main/docs/configuration.md).

# This server's address on the private network; compose.yaml publishes the port there only.
PRIVATE_IP=

PUBLIC_URL=https://vorschau.3dbruckner.de
PREVIEW_SECRET=
PREVIEW_ALLOWED_EMAILS=
# Sign-in through the business's authentik (its application preview), the only way in.
PREVIEW_OIDC_AUTHENTIK_CLIENT_ID=preview
PREVIEW_OIDC_AUTHENTIK_CLIENT_SECRET=
PREVIEW_OIDC_AUTHENTIK_ISSUER=
PREVIEW_OIDC_AUTHENTIK_LABEL=authentik

# The brand: name, link, colour, legal links, and the logo as a file in data/ (brand/logo.svg), all written by the deployment.
PREVIEW_BRAND_NAME=
PREVIEW_BRAND_URL=
PREVIEW_ACCENT_COLOR=
PREVIEW_LOGO=
PREVIEW_IMPRINT_URL=
PREVIEW_PRIVACY_URL=

# Mail: a customer's feedback to the operator, through this SMTP server (it also turns on sign-in by mailed code for the allowed addresses).
PREVIEW_SMTP_URL=
PREVIEW_SMTP_FROM=
PREVIEW_FEEDBACK_EMAIL=
# Print figures for files without their own: the slicing service and its token.
PREVIEW_SLICER_URL=
PREVIEW_SLICER_TOKEN=
TZ=Europe/Berlin
